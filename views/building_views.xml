<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="building_info_list_view" model="ir.ui.view">
    <field name="name">building.info.list</field>
    <field name="model">building.info</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="address"/>
        </list>
    </field>
</record>
    <record id="building_info_form_view" model="ir.ui.view">
        <field name="name">building.info.form</field>
        <field name="model">building.info</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="address"/>
                    </group>
                    <notebook>
                        <page string="Floors">
                            <field name="floor_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_building_info" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">building.info</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
