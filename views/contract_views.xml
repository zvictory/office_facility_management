<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="office_contract_list_view" model="ir.ui.view">
        <field name="name">office.contract.list</field>
        <field name="model">office.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="room_id"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="monthly_rent"/>
            </list>
        </field>
    </record>
    <record id="office_contract_form_view" model="ir.ui.view">
        <field name="name">office.contract.form</field>
        <field name="model">office.contract</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="room_id"/>
                        <field name="tenant_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="monthly_rent"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_office_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">office.contract</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
